---
import author from '../data/author.json';
import book from '../data/book.json';

const year = new Date().getFullYear();

const nav = [
  { label: 'The book', href: '/the-book/' },
  { label: 'Author', href: '/author/' },
  { label: 'Press', href: '/press/' },
  { label: 'Buy', href: '/buy/' },
  { label: 'Contact', href: '/contact/' },
];
---

<footer class="register-dark border-t border-field/10">
  <div class="shell py-16">
    <div class="grid gap-12 md:grid-cols-[1.2fr_1fr_1fr]">
      <div>
        <p class="label text-field/90">{book.title}</p>
        <p class="mt-3 max-w-[34ch] text-sm text-field/65">
          {book.subtitle} &middot; {author.fullName}
        </p>
      </div>

      <nav aria-label="Footer">
        <p class="label text-field/60">Site</p>
        <ul class="mt-2">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="flex min-h-11 items-center text-sm text-field/65 transition-colors hover:text-lumen"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <p class="label text-field/60">Elsewhere</p>
        <ul class="mt-2">
          {
            author.social.map((s) => (
              <li>
                <a
                  href={s.url}
                  rel="noopener me"
                  class="flex min-h-11 items-center text-sm text-field/65 transition-colors hover:text-lumen"
                >
                  {s.name}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={author.practiceUrl}
              rel="noopener"
              class="flex min-h-11 items-center text-sm text-field/65 transition-colors hover:text-lumen"
            >
              Surgical practice
            </a>
          </li>
        </ul>
      </div>
    </div>

    <hr class="rule mt-14" />
    <p class="label mt-6 text-field/60">
      &copy; {year} {book.title}
    </p>
  </div>
</footer>
