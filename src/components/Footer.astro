---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import cover from '../assets/cover.png';
import author from '../data/author.json';
import book from '../data/book.json';
import { money } from '../lib/format';

const year = new Date().getFullYear();

const formats = (await getCollection('formats')).sort(
  (a, b) => a.data.order - b.data.order,
);

const explore = [
  { label: 'The book', href: '/the-book/' },
  { label: 'Read an excerpt', href: '/excerpt/' },
  { label: 'The author', href: '/author/' },
  { label: 'Research', href: '/research/' },
  { label: 'Media kit', href: '/media/' },
  { label: 'Editions', href: '/buy/' },
  { label: 'Contact', href: '/contact/' },
];

/** Scholar and ResearchGate first: for an academic author they carry the most weight. */
const order = ['Google Scholar', 'ResearchGate', 'LinkedIn', 'X', 'Instagram', 'YouTube'];
const elsewhere = [...author.social].sort(
  (a, b) => order.indexOf(a.name) - order.indexOf(b.name),
);
---

<!-- Closing band. A book site's footer is the last conversion point, so it
     ends on the book rather than on a sitemap. -->
<aside class="surface-sunken border-t border-line">
  <div
    class="shell flex flex-wrap items-center justify-between gap-x-12 gap-y-8 py-14"
  >
    <div class="flex items-center gap-6">
      <Image
        src={cover}
        alt=""
        aria-hidden="true"
        widths={[96, 192]}
        sizes="4rem"
        loading="lazy"
        class="w-16 shrink-0 shadow-[var(--elevation)]"
      />
      <div>
        <p class="font-display text-h3 !text-[1.375rem] text-fg">
          {book.title}
        </p>
        <p class="mt-1 text-[0.9375rem] text-muted">
          {book.subtitle} &middot; {author.fullName}
        </p>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <a href="/buy/" class="btn btn-primary">Order the book</a>
      <a href="/excerpt/" class="btn btn-ghost">Read an excerpt</a>
    </div>
  </div>
</aside>

<footer class="surface border-t border-line">
  <div class="shell py-16 lg:py-20">
    <div class="grid gap-12 md:grid-cols-3 lg:gap-16">
      <!-- Editions. Real data, which is also what stops this column dying
           two lines in and leaving the row ragged. -->
      <div>
        <p class="eyebrow">Editions</p>
        <dl class="mt-5">
          {
            formats.map((f) => (
              <div class="flex items-baseline justify-between gap-4 border-t border-line py-3">
                <dt class="text-[1rem] text-fg">{f.data.name}</dt>
                <dd class="text-right">
                  <span class="label !text-[0.8125rem] tabular-nums text-muted">
                    {money(f.data.price, f.data.currency)}
                  </span>
                  {f.data.isbn && (
                    <span class="label ml-3 hidden !text-[0.8125rem] tabular-nums text-faint lg:inline">
                      {f.data.isbn}
                    </span>
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <nav aria-label="Footer">
        <p class="eyebrow">Explore</p>
        <ul class="mt-2">
          {
            explore.map((item) => (
              <li class="border-t border-line">
                <a
                  href={item.href}
                  class="flex min-h-12 items-center text-[1.0625rem] font-medium text-fg transition-colors hover:text-accent"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <p class="eyebrow">Prof. Gordon Slater</p>
        <ul class="mt-2">
          {
            elsewhere.map((s) => (
              <li class="border-t border-line">
                <a
                  href={s.url}
                  target="_blank" rel="noopener me"
                  class="group flex min-h-12 items-center justify-between gap-3 text-[1.0625rem] font-medium text-fg transition-colors hover:text-accent"
                >
                  <span>{s.name}</span>
                  <span aria-hidden="true" class="text-faint">&#8599;</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <hr class="rule-metal mt-16" />

    <div
      class="mt-6 flex flex-wrap items-center justify-between gap-x-8 gap-y-3 text-[0.9375rem] text-faint"
    >
      <p>&copy; {year} {author.fullName}. All rights reserved.</p>

      <p class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <!-- CC BY 4.0 requires attribution wherever the work is used. The
             README is not where a reader looks, so it is discharged here. -->
        <span>
          Micrograph by Erin Rod,{' '}
          <a
            href="https://creativecommons.org/licenses/by/4.0/"
            target="_blank" rel="noopener license"
            class="underline decoration-line underline-offset-4 transition-colors hover:text-fg"
            >CC BY 4.0</a
          >
        </span>
        <a
          href={author.practiceUrl}
          target="_blank" rel="noopener"
          class="inline-flex min-h-11 items-center underline decoration-line underline-offset-4 transition-colors hover:text-fg"
        >
          Surgical practice
        </a>
      </p>
    </div>
  </div>
</footer>
