---
import book from '../data/book.json';

const bs = book.bestseller;

/**
 * Amazon best-seller badges are category- and time-specific. Until the client
 * supplies the category and a dated screenshot, this renders the generic claim
 * only. Filling `category` (and optionally `rank`) in book.json upgrades it to
 * a precise, substantiated statement with no code change.
 */
const text = bs.category
  ? `${bs.rank ? `#${bs.rank}` : 'Best seller'} in ${bs.category} — Amazon`
  : bs.label;
---

{
  bs.claimed && (
    <p class="bestseller label inline-flex flex-wrap items-center gap-x-3 gap-y-1">
      <span aria-hidden="true" class="bestseller-rule" />
      <span>{text}</span>
      {bs.verifiedOn && <span class="bestseller-date">verified {bs.verifiedOn}</span>}
    </p>
  )
}

<style>
  /* Register-aware: the emissive cyan only clears AA on the dark field, so the
     light register swaps to its darker counterpart rather than washing out. */
  .bestseller {
    color: var(--color-lumen);
  }

  :global(.register-light) .bestseller {
    color: var(--color-lumen-deep);
  }

  .bestseller-rule {
    display: inline-block;
    height: 1px;
    width: 2rem;
    background: currentColor;
    opacity: 0.6;
  }

  .bestseller-date {
    color: color-mix(in oklab, currentColor 62%, transparent);
  }
</style>
