---
import author from '../data/author.json';
---

<section id="author" class="register-light py-28 lg:py-36">
  <div class="shell grid gap-16 lg:grid-cols-[0.9fr_1.1fr] lg:gap-24">
    <div>
      <p class="label text-graphite">Figure 2 &middot; The author</p>
      <h2 class="mt-5 text-h2 text-ink">{author.fullName}</h2>
      <p class="label mt-4 text-graphite">{author.role}</p>

      <dl class="mt-10 space-y-5">
        {
          author.credentials.map((c) => (
            <div class="border-t border-ink/12 pt-4">
              <dt class="label text-ink">{c.label}</dt>
              <dd class="mt-1.5 text-sm text-graphite">{c.detail}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="lg:pt-16">
      <p class="text-lead text-ink/85">{author.short}</p>
      <p class="mt-6 max-w-measure text-ink/70">{author.long}</p>

      <div class="mt-10 flex flex-wrap gap-3">
        <a href="/author/" class="btn btn-ghost !text-ink">Full biography</a>
        <a
          href={author.practiceUrl}
          rel="noopener"
          class="btn btn-ghost !text-ink"
        >
          Surgical practice
        </a>
      </div>
    </div>
  </div>
</section>
