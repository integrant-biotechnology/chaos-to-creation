---
import author from '../data/author.json';
import book from '../data/book.json';
import BestsellerMark from './BestsellerMark.astro';
---

<section id="author" class="surface py-28 lg:py-36">
  <div class="shell grid gap-16 lg:grid-cols-[0.9fr_1.1fr] lg:gap-24">
    <div>
      <p class="label text-muted">Figure 2 &middot; The author</p>
      <h2 class="mt-5 text-h2 text-fg">{author.fullName}</h2>
      <p class="label mt-4 text-muted">{author.role}</p>

      {
        book.bestseller.claimed && (
          <div class="mt-7">
            <BestsellerMark variant="seal" withAuthor />
          </div>
        )
      }

      <dl class="mt-10 space-y-5">
        {
          author.credentials.map((c) => (
            <div class="border-t border-line pt-4">
              <dt class="label text-fg">{c.label}</dt>
              <dd class="mt-1.5 text-sm text-muted">{c.detail}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="lg:pt-16">
      <p class="text-lead text-muted">{author.short}</p>
      <p class="mt-6 max-w-measure text-muted">{author.long}</p>

      <div class="mt-10 flex flex-wrap gap-3">
        <a href="/author/" class="btn btn-ghost">Full biography</a>
        <a
          href={author.practiceUrl}
          rel="noopener"
          class="btn btn-ghost"
        >
          Surgical practice
        </a>
      </div>
    </div>
  </div>
</section>
