---
/**
 * Dark is the default for everyone, regardless of OS setting — a deliberate
 * override of prefers-color-scheme, recorded as such. An explicit choice here
 * is remembered in localStorage and applied before first paint by the inline
 * script in Base.astro, so there is never a flash of the wrong theme.
 */
---

<button
  id="theme-toggle"
  type="button"
  class="theme-toggle"
  aria-label="Switch to light theme"
>
  <svg
    class="icon icon-sun"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4.25"></circle>
    <path
      d="M12 2.5v2.2M12 19.3v2.2M21.5 12h-2.2M4.7 12H2.5M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6M18.7 18.7l-1.6-1.6M6.9 6.9L5.3 5.3"
    ></path>
  </svg>

  <svg
    class="icon icon-moon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20 13.4A8.4 8.4 0 1 1 10.6 4a6.9 6.9 0 0 0 9.4 9.4Z"></path>
  </svg>
</button>

<script is:inline>
  (() => {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    const root = document.documentElement;

    const sync = () => {
      const light = root.dataset.theme === 'light';
      btn.setAttribute(
        'aria-label',
        light ? 'Switch to dark theme' : 'Switch to light theme',
      );
    };

    btn.addEventListener('click', () => {
      const light = root.dataset.theme === 'light';
      if (light) {
        delete root.dataset.theme;
      } else {
        root.dataset.theme = 'light';
      }
      try {
        localStorage.setItem('theme', light ? 'dark' : 'light');
      } catch {}
      sync();
    });

    sync();
  })();
</script>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--color-text);
    border: 1px solid var(--color-line);
    background: transparent;
    cursor: pointer;
    transition:
      border-color 200ms ease,
      background-color 200ms ease;
  }

  .theme-toggle:hover {
    border-color: var(--color-line-strong);
    background-color: color-mix(in oklab, var(--color-text) 6%, transparent);
  }

  .icon {
    width: 1.125rem;
    height: 1.125rem;
    grid-area: 1 / 1;
    transition:
      opacity 200ms ease,
      transform 320ms ease;
  }

  /* Dark theme shows the sun (the action available); light shows the moon. */
  .icon-moon {
    opacity: 0;
    transform: rotate(-45deg) scale(0.7);
  }

  :root[data-theme='light'] .icon-sun {
    opacity: 0;
    transform: rotate(45deg) scale(0.7);
  }

  :root[data-theme='light'] .icon-moon {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle,
    .icon {
      transition: none;
    }
  }
</style>
