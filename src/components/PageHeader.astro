---
/**
 * Interior pages open in the dark register with a plate-style masthead, so the
 * monograph apparatus carries across the site rather than living only on the
 * homepage. Body content that follows sits in the light register.
 */
interface Props {
  figure: string;
  title: string;
  lede?: string;
  /**
   * Utility pages step the masthead down a size and pull the first section
   * into the opening viewport — the buy-page pattern, shared here.
   */
  compact?: boolean;
}

const { figure, title, lede, compact = false } = Astro.props;
---

<section class="surface relative overflow-hidden">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div
      class="absolute -left-[8%] top-[-30%] h-[34rem] w-[34rem] rounded-full opacity-[0.13] blur-[110px]"
      style="background: radial-gradient(circle, var(--color-accent) 0%, transparent 68%)"
    >
    </div>
  </div>

  <div
    class:list={[
      'shell relative',
      compact ? 'pb-10 pt-10 lg:pb-12 lg:pt-12' : 'pb-24 pt-24 lg:pb-28 lg:pt-32',
    ]}
  >
    <p class="eyebrow">{figure}</p>
    <h1
      class:list={[
        'hang max-w-[20ch]',
        compact ? 'mt-4 text-h2' : 'mt-5 text-h1',
      ]}
    >
      {title}
    </h1>
    {
      lede && (
        <p
          class:list={[
            'max-w-[52ch] text-lead text-muted',
            compact ? 'mt-4' : 'mt-8',
          ]}
        >
          {lede}
        </p>
      )
    }
    <slot />
  </div>
</section>
