---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import cover from '../assets/cover.png';
import micrograph from '../assets/micrograph.jpg';
import book from '../data/book.json';
import author from '../data/author.json';
import BestsellerMark from './BestsellerMark.astro';

const formats = (await getCollection('formats')).sort(
  (a, b) => a.data.order - b.data.order,
);

/**
 * "CHAOS" is set as individual glyphs carrying a deterministic scatter —
 * displacement, rotation and blur that resolve on load. "CREATION" is crisp
 * throughout. The title performs the argument of the book rather than
 * describing it, and the values are hard-coded rather than random so the
 * composition is identical on every build.
 */
const chaos = [
  { ch: 'C', x: -0.06, y: -0.18, r: -7 },
  { ch: 'H', x: 0.05, y: 0.14, r: 5 },
  { ch: 'A', x: -0.03, y: 0.21, r: 9 },
  { ch: 'O', x: 0.07, y: -0.12, r: -6 },
  { ch: 'S', x: -0.04, y: 0.08, r: 4 },
];
---

<section class="surface relative overflow-hidden">
  <!-- Dark-field ground: a real immunofluorescence micrograph rather than a
       CSS gradient pretending to be one. It is heavily blurred, so it is
       served at a fraction of its native size — resolution is wasted on an
       image nobody sees sharply. Decorative, hence aria-hidden and empty alt. -->
  <div aria-hidden="true" class="hero-ground pointer-events-none absolute inset-0">
    <Image
      src={micrograph}
      alt=""
      widths={[560, 720]}
      sizes="100vw"
      loading="eager"
      class="drift h-full w-full object-cover"
    />
  </div>
  <div aria-hidden="true" class="hero-scrim"></div>

  <div
    class="shell relative grid items-center gap-16 pb-24 pt-20 lg:grid-cols-[1.28fr_0.72fr] lg:gap-16 lg:pb-32 lg:pt-28"
  >
    <!-- Type -->
    <div>
      <p class="label mb-6 text-muted">
        {author.fullName} &middot; MBBS, FRACS
      </p>

      <h1 class="hero-title hang">
        <span class="sr-only">Chaos to Creation</span>
        <span class="hero-line" aria-hidden="true">
          <span class="hero-chaos">
            {
              chaos.map((g, i) => (
                <span
                  class="hero-glyph"
                  style={`--gx:${g.x}em; --gy:${g.y}em; --gr:${g.r}deg; --gd:${i * 70}ms`}
                >
                  {g.ch}
                </span>
              ))
            }
          </span>
          <span class="hero-hinge">
            <span class="hero-hinge-rule"></span>
            <span class="hero-hinge-word">to</span>
          </span>
        </span>
        <span class="hero-creation" aria-hidden="true">Creation</span>
      </h1>

      <p class="mt-8 max-w-[46ch] text-lead text-muted">
        {book.summary}
      </p>

      <div class="mt-10">
        <BestsellerMark variant="seal" withAuthor />
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="/buy/" class="btn btn-primary">Order the book</a>
        <a href="/the-book/" class="btn btn-ghost">Read an extract</a>
      </div>

      <ul class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-2">
        {
          formats.map((f) => (
            <li>
              <a
                href={f.data.url}
                rel="noopener"
                class="label flex min-h-11 items-center text-fg transition-colors hover:text-accent"
              >
                {f.data.name}
                <span class="ml-1.5 text-muted">
                  ${f.data.price.toFixed(2)}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Plate. Deliberately restrained: this is a specimen placed beside the
         argument, not the argument itself. The title carries the page. -->
    <figure class="relative mx-auto w-full max-w-[17rem] lg:mx-0 lg:ml-auto lg:max-w-[19rem]">
      <Image
        src={cover}
        alt={`Cover of ${book.title}: ${book.subtitle}, by ${author.fullName}`}
        widths={[272, 340, 480]}
        sizes="(max-width: 1023px) 17rem, 19rem"
        loading="eager"
        fetchpriority="high"
        class="w-full drop-shadow-[0_36px_70px_rgba(0,0,0,0.72)]"
      />
      <figcaption class="label mt-6 flex items-center gap-3 text-muted">
        <span class="whitespace-nowrap text-metal">Plate I</span>
        <span aria-hidden="true" class="h-px flex-1 bg-line"></span>
        <span class="whitespace-nowrap">Hardcover, {book.published}</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  /* The micrograph is atmosphere, not subject: blurred past legibility, held
     under a wash of the surface colour so type contrast is never at its mercy.
     Measured, not eyeballed — see the contrast audit. */
  .hero-ground {
    filter: blur(46px) saturate(135%);
    opacity: 0.34;
    transform: scale(1.18);
  }

  :root[data-theme='light'] .hero-ground {
    opacity: 0.16;
    filter: blur(46px) saturate(115%);
  }

  /* A scrim between the image and the type, so contrast is structural rather
     than a happy accident of which pixels sit behind which word. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to right,
        var(--color-surface) 0%,
        color-mix(in oklab, var(--color-surface) 82%, transparent) 46%,
        color-mix(in oklab, var(--color-surface) 40%, transparent) 100%),
      linear-gradient(to bottom,
        var(--color-surface) 0%,
        transparent 22%,
        transparent 74%,
        var(--color-surface) 100%);
  }

  .hero-title {
    font-size: var(--text-mega);
    line-height: var(--text-mega--line-height);
    letter-spacing: -0.03em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .hero-creation {
    display: block;
  }

  .hero-glyph {
    display: inline-block;
    will-change: transform, filter, opacity;
  }

  /* The hinge occupies the gap the shorter word leaves, so the ragged edge
     becomes structure rather than dead space. Set in the utility face: it is
     the pivot between two states, not part of either. */
  .hero-line {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2.25rem);
  }

  .hero-chaos {
    flex: none;
  }

  .hero-hinge {
    display: flex;
    flex: 1;
    align-items: center;
    gap: clamp(0.6rem, 1.4vw, 1.1rem);
    min-width: 0;
    /* Sits on the optical centre of the cap height, not the em box. */
    transform: translateY(0.12em);
  }

  .hero-hinge-rule {
    height: 1px;
    flex: 1;
    min-width: 1.5rem;
    background: color-mix(in oklab, var(--color-accent) 55%, transparent);
  }

  .hero-hinge-word {
    font-family: var(--font-mono);
    font-size: clamp(0.8125rem, 0.7rem + 0.4vw, 1.0625rem);
    letter-spacing: 0.3em;
    text-transform: lowercase;
    font-weight: 400;
    color: var(--color-accent);
    padding-right: 0.3em;
  }

  /* On a narrow screen the rule stretched to 115px against a 182px word —
     at 52px type that reads as a divider rather than a hinge. Fixed short
     length below the two-column breakpoint keeps the proportion. */
  @media (width < 48rem) {
    .hero-hinge {
      flex: none;
    }

    .hero-hinge-rule {
      flex: none;
      width: 2.25rem;
      min-width: 0;
    }
  }

  .hero-creation {
    color: var(--color-fg);
  }

  /* Settled is the default state. The scatter only exists inside the
     motion-safe block, so reduced-motion users get the resolved title
     immediately and nothing is animated on their behalf. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-glyph {
      animation: glyph-settle 1100ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: var(--gd);
    }
  }

  @keyframes glyph-settle {
    from {
      opacity: 0;
      filter: blur(14px);
      transform: translate(var(--gx), var(--gy)) rotate(var(--gr)) scale(1.04);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: translate(0, 0) rotate(0) scale(1);
    }
  }
</style>
