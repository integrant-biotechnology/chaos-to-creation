---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import cover from '../assets/cover.png';
import book from '../data/book.json';
import author from '../data/author.json';
import BestsellerMark from './BestsellerMark.astro';

const formats = (await getCollection('formats')).sort(
  (a, b) => a.data.order - b.data.order,
);

/**
 * "CHAOS" is set as individual glyphs carrying a deterministic scatter —
 * displacement, rotation and blur that resolve on load. "CREATION" is crisp
 * throughout. The title performs the argument of the book rather than
 * describing it, and the values are hard-coded rather than random so the
 * composition is identical on every build.
 */
const chaos = [
  { ch: 'C', x: -0.06, y: -0.18, r: -7 },
  { ch: 'H', x: 0.05, y: 0.14, r: 5 },
  { ch: 'A', x: -0.03, y: 0.21, r: 9 },
  { ch: 'O', x: 0.07, y: -0.12, r: -6 },
  { ch: 'S', x: -0.04, y: 0.08, r: 4 },
];
---

<section class="register-dark relative overflow-hidden">
  <!-- Dark-field wash: two out-of-focus fluorescence blooms, the visual
       signature of the confocal imagery this direction is drawn from. -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div
      class="absolute -left-[10%] top-[8%] h-[46rem] w-[46rem] rounded-full opacity-[0.16] blur-[110px]"
      style="background: radial-gradient(circle, var(--color-lumen) 0%, transparent 68%)"
    >
    </div>
    <div
      class="absolute -right-[14%] bottom-[-12%] h-[38rem] w-[38rem] rounded-full opacity-[0.10] blur-[120px]"
      style="background: radial-gradient(circle, var(--color-stain) 0%, transparent 68%)"
    >
    </div>
  </div>

  <div
    class="shell relative grid items-center gap-16 pb-24 pt-36 lg:grid-cols-[1.28fr_0.72fr] lg:gap-16 lg:pb-32 lg:pt-40"
  >
    <!-- Type -->
    <div>
      <p class="label mb-6 text-field/55">
        {author.fullName} &middot; MBBS, FRACS
      </p>

      <h1 class="hero-title">
        <span class="sr-only">Chaos to Creation</span>
        <span class="hero-line" aria-hidden="true">
          <span class="hero-chaos">
            {
              chaos.map((g, i) => (
                <span
                  class="hero-glyph"
                  style={`--gx:${g.x}em; --gy:${g.y}em; --gr:${g.r}deg; --gd:${i * 70}ms`}
                >
                  {g.ch}
                </span>
              ))
            }
          </span>
          <span class="hero-hinge">
            <span class="hero-hinge-rule"></span>
            <span class="hero-hinge-word">to</span>
          </span>
        </span>
        <span class="hero-creation" aria-hidden="true">Creation</span>
      </h1>

      <p class="mt-8 max-w-[46ch] text-lead text-field/72">
        {book.summary}
      </p>

      <div class="mt-10">
        <BestsellerMark />
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="/buy/" class="btn btn-primary">Order the book</a>
        <a href="/the-book/" class="btn btn-ghost">Read an extract</a>
      </div>

      <ul class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-2">
        {
          formats.map((f) => (
            <li>
              <a
                href={f.data.url}
                rel="noopener"
                class="label text-field/65 transition-colors hover:text-lumen"
              >
                {f.data.name}
                <span class="ml-1.5 text-field/60">
                  ${f.data.price.toFixed(2)}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Plate. Deliberately restrained: this is a specimen placed beside the
         argument, not the argument itself. The title carries the page. -->
    <figure class="relative mx-auto w-full max-w-[17rem] lg:mx-0 lg:ml-auto lg:max-w-[19rem]">
      <Image
        src={cover}
        alt={`Cover of ${book.title}: ${book.subtitle}, by ${author.fullName}`}
        widths={[272, 304, 448, 608]}
        sizes="(max-width: 1023px) 17rem, 19rem"
        loading="eager"
        fetchpriority="high"
        class="w-full drop-shadow-[0_36px_70px_rgba(0,0,0,0.72)]"
      />
      <figcaption class="label mt-6 flex items-center gap-3 text-field/60">
        <span class="whitespace-nowrap text-lumen/70">Plate I</span>
        <span aria-hidden="true" class="h-px flex-1 bg-field/15"></span>
        <span class="whitespace-nowrap">Hardcover, {book.published}</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero-title {
    font-size: var(--text-mega);
    line-height: var(--text-mega--line-height);
    letter-spacing: -0.03em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .hero-creation {
    display: block;
  }

  .hero-glyph {
    display: inline-block;
    will-change: transform, filter, opacity;
  }

  /* The hinge occupies the gap the shorter word leaves, so the ragged edge
     becomes structure rather than dead space. Set in the utility face: it is
     the pivot between two states, not part of either. */
  .hero-line {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2.25rem);
  }

  .hero-chaos {
    flex: none;
  }

  .hero-hinge {
    display: flex;
    flex: 1;
    align-items: center;
    gap: clamp(0.6rem, 1.4vw, 1.1rem);
    min-width: 0;
    /* Sits on the optical centre of the cap height, not the em box. */
    transform: translateY(0.12em);
  }

  .hero-hinge-rule {
    height: 1px;
    flex: 1;
    min-width: 1.5rem;
    background: color-mix(in oklab, var(--color-lumen) 55%, transparent);
  }

  .hero-hinge-word {
    font-family: var(--font-mono);
    font-size: clamp(0.8125rem, 0.7rem + 0.4vw, 1.0625rem);
    letter-spacing: 0.3em;
    text-transform: lowercase;
    font-weight: 400;
    color: var(--color-lumen);
    padding-right: 0.3em;
  }

  .hero-creation {
    color: var(--color-field);
  }

  /* Settled is the default state. The scatter only exists inside the
     motion-safe block, so reduced-motion users get the resolved title
     immediately and nothing is animated on their behalf. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-glyph {
      animation: glyph-settle 1100ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: var(--gd);
    }
  }

  @keyframes glyph-settle {
    from {
      opacity: 0;
      filter: blur(14px);
      transform: translate(var(--gx), var(--gy)) rotate(var(--gr)) scale(1.04);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: translate(0, 0) rotate(0) scale(1);
    }
  }
</style>
