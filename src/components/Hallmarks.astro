---
import { getCollection } from 'astro:content';

const hallmarks = (await getCollection('hallmarks')).sort(
  (a, b) => a.data.order - b.data.order,
);

/**
 * Deterministic scatter per card. Each arrives displaced and settles as it
 * enters the viewport — nine disordered things resolving into a legible set,
 * which is the book's argument in one gesture.
 *
 * The numbering is honest here and nowhere else on the site: the hallmarks are
 * a canonical enumerated set from the literature, so the index is information.
 * They are a set rather than a sequence, so this is a grid, not a numbered
 * process list.
 */
const scatter = [
  { x: '-1.4rem', y: '2.2rem', r: '-2.4deg' },
  { x: '1.1rem', y: '3.4rem', r: '1.8deg' },
  { x: '-0.7rem', y: '1.6rem', r: '2.6deg' },
  { x: '1.6rem', y: '2.8rem', r: '-1.6deg' },
  { x: '-1.2rem', y: '3.8rem', r: '2.1deg' },
  { x: '0.9rem', y: '1.9rem', r: '-2.8deg' },
  { x: '-1.5rem', y: '3.1rem', r: '1.4deg' },
  { x: '1.3rem', y: '2.4rem', r: '-2.2deg' },
  { x: '-0.9rem', y: '3.6rem', r: '2.9deg' },
];

/** Static vertical offsets give the grid a constellation cadence on desktop. */
const lift = ['0', '3.5rem', '1.25rem'];
---

<!-- overflow-x clip (not hidden) contains the scatter transforms without
     creating a scroll container, which would break the sticky asides. -->
<section
  id="hallmarks"
  class="register-dark relative [overflow-x:clip] py-28 lg:py-40"
>
  <div class="shell">
    <header class="max-w-[34rem]">
      <p class="label text-lumen/80">Figure 1 &middot; The nine hallmarks</p>
      <h2 class="mt-5 text-h2">Aging is not one process. It is nine.</h2>
      <p class="mt-6 text-lead text-field/65">
        Each is a distinct mechanism of decline, and each is now a target.
        The book takes them one at a time, and asks what current science can
        actually do about them.
      </p>
    </header>

    <ol class="mt-20 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {
        hallmarks.map((h, i) => (
          <li
            class="resolve group relative lg:[margin-top:var(--lift)]"
            style={`--resolve-x:${scatter[i].x}; --resolve-y:${scatter[i].y}; --resolve-rotate:${scatter[i].r}; --lift:${lift[i % 3]}`}
          >
            <div class="flex items-baseline gap-4">
              <span class="label text-lumen tabular-nums">
                {String(h.data.order).padStart(2, '0')}
              </span>
              <span aria-hidden="true" class="h-px flex-1 bg-field/12" />
            </div>
            <h3 class="mt-4 text-h3 text-field">{h.data.name}</h3>
            <p class="mt-3 text-field/60">{h.data.summary}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
