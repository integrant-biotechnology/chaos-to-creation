---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import cover from '../assets/cover.png';
import book from '../data/book.json';
import { money } from '../lib/format';

const formats = (await getCollection('formats')).sort(
  (a, b) => a.data.order - b.data.order,
);

/**
 * Gentle settle-on-entry — the same vocabulary as the hallmark cards. All
 * card edges stay flush: the earlier featured-card raise read as
 * misalignment, not promotion, so recommendation is carried by the tag, the
 * stronger border and the primary CTA instead.
 */
const scatter = [
  { x: '-0.6rem', y: '1.4rem', r: '-1deg' },
  { x: '0.5rem', y: '1.8rem', r: '0.8deg' },
  { x: '-0.4rem', y: '1.1rem', r: '1.1deg' },
];
---

<ul class="grid gap-5 md:grid-cols-3 lg:gap-6">
  {
    formats.map((f, i) => (
      <li
        class:list={[
          'panel panel-lift resolve relative flex flex-col p-7 lg:p-8',
          f.data.featured && 'edition-featured',
        ]}
        style={`--resolve-x:${scatter[i].x}; --resolve-y:${scatter[i].y}; --resolve-rotate:${scatter[i].r}`}
      >
        <div class="flex items-center gap-4">
          <Image
            src={cover}
            alt=""
            aria-hidden="true"
            widths={[64, 128]}
            sizes="2.75rem"
            loading="lazy"
            class="w-11 shrink-0 shadow-[var(--elevation)]"
          />
          <div class="flex flex-1 items-baseline gap-4">
            <span class="eyebrow card-kicker">{f.data.name}</span>
            <span aria-hidden="true" class="h-px flex-1 bg-line" />
            {f.data.featured && <span class="eyebrow !text-accent">Recommended</span>}
          </div>
        </div>

        <p
          class:list={[
            'mt-6 font-display leading-none tabular-nums',
            f.data.featured
              ? 'text-[2.25rem] text-fg lg:text-[2.75rem]'
              : 'text-[1.75rem] text-muted lg:text-[2rem]',
          ]}
        >
          {money(f.data.price, f.data.currency)}
        </p>

        <p class="mt-4 flex-1 text-[0.9375rem] leading-relaxed text-muted">
          {f.data.note}
        </p>

        {/* Two meta rows on every card — ISBN for print, ASIN for Kindle —
            so the clusters and the CTAs sit on identical baselines. */}
        <div class="mt-6 space-y-1.5">
          {f.data.delivery && <p class="eyebrow">{f.data.delivery}</p>}
          <p class="label text-faint">
            {f.data.isbn ? `ISBN ${f.data.isbn}` : `ASIN ${f.data.asin}`}
          </p>
        </div>

        <a
          href={f.data.url}
          target="_blank"
          rel="noopener"
          class:list={[
            'btn mt-6 w-full',
            f.data.featured ? 'btn-primary' : 'btn-ghost',
          ]}
        >
          Order {f.data.name.toLowerCase()}
          <span aria-hidden="true">&#8599;</span>
          <span class="sr-only">
            {' '}
            on Amazon Australia (opens in a new tab)
          </span>
        </a>
      </li>
    ))
  }
</ul>

<p class="mt-10 text-sm text-muted">
  Also available through the <a
    href={book.amazonAuthorStore}
    target="_blank"
    rel="noopener"
    class="underline decoration-line underline-offset-4 transition-colors hover:text-fg"
    >author store<span class="sr-only"> (opens in a new tab)</span></a
  >. For bulk or institutional orders, <a
    href="/contact/"
    class="underline decoration-line underline-offset-4 transition-colors hover:text-fg"
    >get in touch</a
  >.
</p>

<style>
  /* Recommendation without breaking the grid line: tag, stronger hairline,
     primary CTA. No raise — one lifted top edge scans as error. */
  .edition-featured {
    border-color: var(--color-line-strong);
  }
</style>
