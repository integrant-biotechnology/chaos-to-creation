---
import book from '../data/book.json';
import EditionCards from './EditionCards.astro';

/**
 * The standalone editions section, used where it must introduce itself: the
 * homepage and /the-book/. /buy/ composes <EditionCards /> directly instead —
 * a page whose h1 already says "Order the book" does not need a second
 * headline saying it again.
 */
---

<section id="buy" class="surface-sunken border-t border-line py-28 lg:py-36">
  <div class="shell">
    <header
      class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,30rem)] lg:items-end lg:gap-20"
    >
      <div>
        <p class="eyebrow">Available now</p>
        <h2 class="hang mt-5 text-h2 text-fg">Three editions.</h2>
      </div>
      <p class="text-lead text-muted lg:pb-1.5">
        Published {book.published}. Ordered through Amazon Australia.
      </p>
    </header>

    <div class="mt-16">
      <EditionCards />
    </div>
  </div>
</section>
