---
import { getCollection } from 'astro:content';
import book from '../data/book.json';

const formats = (await getCollection('formats')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section id="buy" class="register-light border-t border-ink/10 py-28 lg:py-36">
  <div class="shell">
    <header class="max-w-[30rem]">
      <p class="label text-graphite">Available now</p>
      <h2 class="mt-5 text-h2 text-ink">Three editions.</h2>
      <p class="mt-6 text-lead text-ink/70">
        Published {book.published}. Ordered through Amazon Australia.
      </p>
    </header>

    <ul class="mt-16 grid gap-px overflow-hidden border border-ink/12 bg-ink/12 md:grid-cols-3">
      {
        formats.map((f) => (
          <li class="flex flex-col bg-field p-8 lg:p-10">
            <p class="label text-graphite">{f.data.name}</p>
            <p class="mt-6 font-display text-h3 text-ink tabular-nums">
              ${f.data.price.toFixed(2)}
              <span class="label ml-1 text-graphite">{f.data.currency}</span>
            </p>
            <p class="mt-4 flex-1 text-sm text-graphite">{f.data.note}</p>
            {f.data.isbn && (
              <p class="label mt-6 text-graphite">ISBN {f.data.isbn}</p>
            )}
            <a
              href={f.data.url}
              rel="noopener"
              class="btn btn-ghost mt-8 !text-ink"
            >
              Order {f.data.name.toLowerCase()}
              <span class="sr-only"> on Amazon Australia</span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-10 text-sm text-graphite">
      Also available through the <a
        href={book.amazonAuthorStore}
        rel="noopener"
        class="underline decoration-ink/30 underline-offset-4 transition-colors hover:text-ink"
        >author store</a
      >. For bulk or institutional orders, <a
        href="/contact/"
        class="underline decoration-ink/30 underline-offset-4 transition-colors hover:text-ink"
        >get in touch</a
      >.
    </p>
  </div>
</section>
