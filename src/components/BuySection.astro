---
import { getCollection } from 'astro:content';
import book from '../data/book.json';
import { money } from '../lib/format';

const formats = (await getCollection('formats')).sort(
  (a, b) => a.data.order - b.data.order,
);

/**
 * No cover thumbnails, deliberately: all three editions share one cover art,
 * so three identical thumbnails read as filler — and the cover already
 * appears elsewhere on every page that renders this section. The hierarchy
 * is carried by the price and the featured marker instead.
 */
---

<section id="buy" class="surface-sunken border-t border-line py-28 lg:py-36">
  <div class="shell">
    <header
      class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,30rem)] lg:items-end lg:gap-20"
    >
      <div>
        <p class="eyebrow">Available now</p>
        <h2 class="hang mt-5 text-h2 text-fg">Three editions.</h2>
      </div>
      <p class="text-lead text-muted lg:pb-1.5">
        Published {book.published}. Ordered through Amazon Australia.
      </p>
    </header>

    <ul class="mt-16 grid gap-5 md:grid-cols-3 lg:gap-6">
      {
        formats.map((f) => (
          <li
            class:list={[
              'panel panel-lift relative flex flex-col p-7 lg:p-8',
              f.data.featured && 'edition-featured',
            ]}
          >
            <div class="flex items-baseline gap-4">
              <span class="label card-kicker">{f.data.name}</span>
              <span aria-hidden="true" class="h-px flex-1 bg-line" />
              {f.data.featured && (
                <span class="label text-accent">Recommended</span>
              )}
            </div>

            <p class="mt-6 font-display text-[2rem] leading-none text-fg tabular-nums lg:text-[2.375rem]">
              {money(f.data.price, f.data.currency)}
            </p>

            <p class="mt-4 flex-1 text-[0.9375rem] leading-relaxed text-muted">
              {f.data.note}
            </p>

            {f.data.isbn && (
              <p class="label mt-6 text-faint">ISBN {f.data.isbn}</p>
            )}

            <a
              href={f.data.url}
              rel="noopener"
              class:list={[
                'btn mt-6 w-full',
                f.data.featured ? 'btn-primary' : 'btn-ghost',
              ]}
            >
              Order {f.data.name.toLowerCase()}
              <span class="sr-only"> on Amazon Australia</span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-10 text-sm text-muted">
      Also available through the <a
        href={book.amazonAuthorStore}
        rel="noopener"
        class="underline decoration-line underline-offset-4 transition-colors hover:text-fg"
        >author store</a
      >. For bulk or institutional orders, <a
        href="/contact/"
        class="underline decoration-line underline-offset-4 transition-colors hover:text-fg"
        >get in touch</a
      >.
    </p>
  </div>
</section>

<style>
  /* The recommendation is a quiet promotion: a slight raise and a stronger
     hairline, not a scale carnival. Grid stretch keeps all card bottoms on a
     shared baseline, so the negative top margin makes this card stand proud
     of the row while the CTAs stay aligned. */
  @media (width >= 48rem) {
    .edition-featured {
      margin-top: -0.75rem;
      border-color: var(--color-line-strong);
    }
  }
</style>
