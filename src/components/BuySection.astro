---
import { getCollection } from 'astro:content';
import book from '../data/book.json';
import { money } from '../lib/format';

const formats = (await getCollection('formats')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section id="buy" class="surface border-t border-line py-28 lg:py-36">
  <div class="shell">
    <header class="max-w-[30rem]">
      <p class="label text-muted">Available now</p>
      <h2 class="mt-5 text-h2 text-fg">Three editions.</h2>
      <p class="mt-6 text-lead text-muted">
        Published {book.published}. Ordered through Amazon Australia.
      </p>
    </header>

    <ul class="mt-16 grid gap-px overflow-hidden border border-line bg-line md:grid-cols-3">
      {
        formats.map((f) => (
          <li class="flex flex-col bg-raised p-8 lg:p-10">
            <p class="label text-muted">{f.data.name}</p>
            <p class="mt-6 font-display text-h3 text-fg tabular-nums">
              {money(f.data.price, f.data.currency)}
            </p>
            <p class="mt-4 flex-1 text-sm text-muted">{f.data.note}</p>
            {f.data.isbn && (
              <p class="label mt-6 text-muted">ISBN {f.data.isbn}</p>
            )}
            <a
              href={f.data.url}
              rel="noopener"
              class="btn btn-ghost mt-8"
            >
              Order {f.data.name.toLowerCase()}
              <span class="sr-only"> on Amazon Australia</span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-10 text-sm text-muted">
      Also available through the <a
        href={book.amazonAuthorStore}
        rel="noopener"
        class="underline decoration-line underline-offset-4 transition-colors hover:text-fg"
        >author store</a
      >. For bulk or institutional orders, <a
        href="/contact/"
        class="underline decoration-line underline-offset-4 transition-colors hover:text-fg"
        >get in touch</a
      >.
    </p>
  </div>
</section>
