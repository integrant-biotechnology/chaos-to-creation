---
const nav = [
  { label: 'The book', href: '/the-book/' },
  { label: 'Author', href: '/author/' },
  { label: 'Research', href: '/research/' },
  { label: 'Media', href: '/media/' },
  { label: 'Contact', href: '/contact/' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href;
---

<header class="site-header">
  <div class="shell flex items-center justify-between gap-6 py-5">
    <a
      href="/"
      class="masthead flex min-h-11 items-center text-fg transition-colors hover:text-accent"
      aria-label="Chaos to Creation — home"
    >
      Chaos&nbsp;to&nbsp;Creation
    </a>

    <!-- Desktop -->
    <nav aria-label="Primary" class="primary-nav hidden lg:block">
      <ul class="flex items-center gap-8">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class="nav-link flex items-center py-2 text-fg"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <a href="/buy/" class="btn btn-primary !px-4 text-[1rem] sm:!px-6"
        >Order</a
      >

      <!-- Mobile. A native disclosure: focusable, toggles on Enter and Space,
           and announces its own expanded state — no JavaScript involved. -->
      <details class="nav-disclosure lg:hidden">
        <summary aria-label="Menu">
          <span class="nav-glyph" aria-hidden="true">
            <span></span><span></span>
          </span>
        </summary>
        <nav aria-label="Primary" class="nav-panel">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isCurrent(item.href) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  /* Sticky, not absolute. With five routes, navigation that scrolls away
     leaves no way back without returning to the top of the page. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--color-surface) 96%, transparent);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid color-mix(in oklab, var(--color-fg) 8%, transparent);
  }

  /* The header carries light text, so it keeps its dark ground even over the
     light register — the backdrop is what makes that legible rather than a
     floating slab. Where scroll-driven animation is available it starts fully
     transparent over the hero and settles in as the page moves. */
  @supports (animation-timeline: scroll()) {
    .site-header {
      animation: header-settle linear both;
      animation-timeline: scroll();
      animation-range: 0 5rem;
    }

    @keyframes header-settle {
      from {
        background: color-mix(in oklab, var(--color-surface) 0%, transparent);
        border-bottom-color: transparent;
      }
      to {
        background: color-mix(in oklab, var(--color-surface) 96%, transparent);
        border-bottom-color: color-mix(
          in oklab,
          var(--color-fg) 8%,
          transparent
        );
      }
    }
  }

  /* -- Mobile disclosure --------------------------------------------------- */
  .nav-disclosure summary {
    display: grid;
    place-items: center;
    /* 44px minimum, per the platform touch-target floor. */
    width: 2.75rem;
    height: 2.75rem;
    cursor: pointer;
    border: 1px solid color-mix(in oklab, var(--color-fg) 22%, transparent);
    list-style: none;
  }

  .nav-disclosure summary::-webkit-details-marker {
    display: none;
  }

  .nav-glyph {
    display: grid;
    gap: 5px;
    width: 1rem;
  }

  .nav-glyph span {
    display: block;
    height: 1px;
    width: 100%;
    background: var(--color-fg);
    transition: transform 220ms ease;
  }

  .nav-disclosure[open] .nav-glyph span:first-child {
    transform: translateY(3px) rotate(45deg);
  }

  .nav-disclosure[open] .nav-glyph span:last-child {
    transform: translateY(-3px) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-glyph span {
      transition: none;
    }
  }

  .nav-panel {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    background: var(--color-surface);
    border-bottom: 1px solid
      color-mix(in oklab, var(--color-fg) 10%, transparent);
    padding: 0.5rem clamp(1.25rem, 5vw, 4.5rem) 1.25rem;
  }

  .nav-panel ul {
    display: flex;
    flex-direction: column;
  }

  .nav-panel a {
    display: flex;
    align-items: center;
    /* Generous rows: comfortably past the 44px floor. */
    min-height: 3.25rem;
    border-top: 1px solid color-mix(in oklab, var(--color-fg) 10%, transparent);
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--color-fg);
  }

  .nav-panel a[aria-current='page'] {
    color: var(--color-accent);
  }

  /* -- Masthead voice -------------------------------------------------------
     Rejected twice as "small and not great" while set in tracked mono caps —
     the site's annotation voice, which reads as metadata at any size. Now the
     publisher pattern: serif masthead, sentence-case sans navigation at
     reading size and full contrast. */
  .masthead {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 12, 'WONK' 0, 'opsz' 40;
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .nav-link {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    /* The underline draws on hover — the index-entry gesture the format
       list already speaks. */
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: left calc(100% - 0.35rem);
    background-size: 0% 1px;
    transition:
      color 200ms ease,
      background-size 220ms ease;
  }

  .nav-link:hover {
    color: var(--color-accent);
    background-size: 100% 1px;
  }

  .nav-link[aria-current='page'] {
    color: var(--color-accent);
    background-size: 100% 1px;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link {
      transition: none;
    }
  }

  /* Phones: the masthead shares the row with controls that never shrink,
     so it steps down. Nav links live in the panel at these widths, where
     they stay at full reading size. */
  @media (width < 40rem) {
    .masthead {
      font-size: 1.0625rem;
    }
  }

  @media (width < 23.75rem) {
    .masthead {
      font-size: 1rem;
    }
  }
</style>
