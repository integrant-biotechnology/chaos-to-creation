---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import book from '../data/book.json';
import author from '../data/author.json';
import { breadcrumbNode, personNode } from '../lib/schema';

const schema = [
  personNode(),
  breadcrumbNode([
    { name: 'Home', path: '/' },
    { name: 'Contact', path: '/contact/' },
  ]),
];

/**
 * Enquiries route by pre-addressed mail links rather than a posted form.
 * No backend, nothing to break, and the subject line arrives already sorted —
 * which matters more for press and speaking than a generic message box does.
 *
 * When a verified sending domain is in place, a posted form can replace this
 * without changing the page's structure.
 */
const to = book.enquiryEmail;
const mailto = (subject: string, body?: string) =>
  `mailto:${to}?subject=${encodeURIComponent(subject)}` +
  (body ? `&body=${encodeURIComponent(body)}` : '');

const routes = [
  {
    kicker: 'Media',
    label: 'Media and interviews',
    detail:
      'Review copies, interview requests, extracts and high-resolution assets.',
    subject: `Media enquiry — ${book.title}`,
    body: 'Outlet:\nDeadline:\nWhat you need:\n',
    aside: { text: 'Press kit', href: '/press/' },
  },
  {
    kicker: 'Speaking',
    label: 'Speaking and events',
    detail:
      'Conferences, panels and lectures on regenerative medicine, longevity science and surgical innovation.',
    subject: `Speaking enquiry — ${author.fullName}`,
    body: 'Event:\nDate:\nAudience and format:\nLocation:\n',
  },
  {
    kicker: 'Orders',
    label: 'Bulk and institutional orders',
    detail:
      'Universities, hospitals, libraries, conferences and corporate gifting.',
    subject: `Bulk order — ${book.title}`,
    body: 'Organisation:\nQuantity:\nEdition:\nDelivery date:\n',
  },
  {
    kicker: 'Rights',
    label: 'Rights and translation',
    detail: 'Foreign language, audio and territorial rights.',
    subject: `Rights enquiry — ${book.title}`,
    body: 'Territory or language:\nRights sought:\nPublisher:\n',
  },
];
---

<Base
  title={`Contact — ${book.title}`}
  description="Media, speaking, bulk order and rights enquiries for Chaos to Creation."
  schema={schema}
>
  <PageHeader
    figure="Figure 8 · Contact"
    title="Get in touch"
    lede="Choose the line that fits and your message arrives already sorted. Everything reaches the same desk."
  />

  <section class="surface py-24 lg:py-32">
    <div class="shell grid gap-16 lg:grid-cols-[1fr_19rem] lg:gap-24">
      <ul class="grid gap-5 sm:grid-cols-2">
        {
          routes.map((r) => (
            <li class="panel panel-lift flex flex-col p-7">
              <div class="flex items-baseline gap-4">
                <span class="label card-kicker">{r.kicker}</span>
                <span aria-hidden="true" class="h-px flex-1 bg-line" />
              </div>
              <h2 class="mt-5 text-h3 !text-[1.25rem] text-fg">{r.label}</h2>
              <p class="mt-2 flex-1 text-[0.9375rem] leading-relaxed text-muted">
                {r.detail}
                {r.aside && (
                  <>
                    {' '}
                    <a
                      href={r.aside.href}
                      class="text-fg underline decoration-line underline-offset-4 transition-colors hover:text-muted"
                    >
                      {r.aside.text}
                    </a>
                    .
                  </>
                )}
              </p>
              <a
                href={mailto(r.subject, r.body)}
                class="btn btn-ghost mt-6 w-full"
              >
                Write to us
              </a>
            </li>
          ))
        }
      </ul>

      <aside class="lg:sticky lg:top-12 lg:self-start">
        <p class="label text-muted">Direct</p>
        <p class="mt-4 border-t border-line pt-4">
          <a
            href={`mailto:${to}`}
            class="text-fg underline decoration-line underline-offset-4 transition-colors hover:text-muted"
          >
            {to}
          </a>
        </p>

        <p class="label mt-10 text-muted">Also useful</p>
        <ul class="mt-4 space-y-3">
          <li class="border-t border-line pt-3">
            <a
              href="/press/"
              class="text-sm text-fg transition-colors hover:text-muted"
              >Press kit and fact sheet</a
            >
          </li>
          <li class="border-t border-line pt-3">
            <a
              href="/buy/"
              class="text-sm text-fg transition-colors hover:text-muted"
              >Order the book</a
            >
          </li>
        </ul>

        <p class="mt-10 text-sm text-muted">
          For clinical or patient enquiries, please contact the <a
            href={author.practiceUrl}
            target="_blank" rel="noopener"
            class="underline decoration-line underline-offset-4 transition-colors hover:text-fg"
            >surgical practice</a
          > directly. This address is for the book only.
        </p>
      </aside>
    </div>
  </section>
</Base>
