---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import BestsellerMark from '../components/BestsellerMark.astro';
import portrait from '../assets/portrait.jpg';
import launch from '../assets/launch.jpg';
import cover from '../assets/cover.png';
import book from '../data/book.json';
import author from '../data/author.json';
import { personNode, bookNode, breadcrumbNode } from '../lib/schema';
import { money } from '../lib/format';

const press = (await getCollection('press')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const endorsements = (await getCollection('endorsements')).sort(
  (a, b) => a.data.order - b.data.order,
);
const formats = (await getCollection('formats')).sort(
  (a, b) => a.data.order - b.data.order,
);

const dateFmt = new Intl.DateTimeFormat('en-AU', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const schema = [
  personNode(),
  await bookNode(),
  breadcrumbNode([
    { name: 'Home', path: '/' },
    { name: 'Media', path: '/media/' },
  ]),
];
---

<Base
  title={`Media kit — ${book.title}`}
  description={`Media resources for ${book.title} by ${author.fullName}: fact sheet, biography, cover art and coverage.`}
  schema={schema}
>
  <PageHeader
    compact
    figure="Media"
    title="Media kit"
    lede="Everything needed to cover the book, in one place. For interviews, review copies or high-resolution assets, get in touch."
  >
    <!-- The kit's table of contents. A working page opens with its index,
         not with empty air below the masthead. -->
    <nav aria-label="Media kit contents" class="mt-8 border-t border-line pt-5">
      <ul class="flex flex-wrap gap-x-10 gap-y-3">
        {
          [
            ['Fact sheet', '#fact-sheet'],
            ['Biography', '#biography'],
            ['Photography', '#photography'],
            ['Coverage', '#coverage'],
          ].map(([label, href]) => (
            <li>
              <a
                href={href}
                class="label flex min-h-11 items-center text-muted transition-colors hover:text-fg"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </PageHeader>

  <!-- Fact sheet -->
  <section id="fact-sheet" class="surface scroll-mt-24 py-16 lg:py-20">
    <div class="shell">
      <div class="grid gap-16 lg:grid-cols-[22rem_1fr] lg:gap-24">
        <header>
          <p class="label text-muted">Fact sheet</p>
          <h2 class="mt-5 text-h2 text-fg">Publication details.</h2>
          <div class="mt-8">
            <BestsellerMark variant="seal" withAuthor />
          </div>
        </header>

        <dl class="grid gap-x-12 gap-y-6 sm:grid-cols-2">
          <div class="border-t border-line pt-4">
            <dt class="label text-muted">Title</dt>
            <dd class="mt-2 text-fg">{book.title}</dd>
          </div>
          <div class="border-t border-line pt-4">
            <dt class="label text-muted">Subtitle</dt>
            <dd class="mt-2 text-fg">{book.subtitle}</dd>
          </div>
          <div class="border-t border-line pt-4">
            <dt class="label text-muted">Author</dt>
            <dd class="mt-2 text-fg">{author.fullName}</dd>
          </div>
          <div class="border-t border-line pt-4">
            <dt class="label text-muted">Author website</dt>
            <dd class="mt-2 text-fg">
              <a
                href={author.personalUrl}
                target="_blank" rel="noopener"
                class="underline decoration-line underline-offset-4 transition-colors hover:text-muted"
              >
                profgordonslater.com.au
              </a>
            </dd>
          </div>
          <div class="border-t border-line pt-4">
            <dt class="label text-muted">Published</dt>
            <dd class="mt-2 text-fg">{book.published}</dd>
          </div>
          {
            formats.map((f) => (
              <div class="border-t border-line pt-4">
                <dt class="label text-muted">{f.data.name}</dt>
                <dd class="mt-2 text-fg tabular-nums">
                  {money(f.data.price, f.data.currency)}
                  {f.data.isbn && (
                    <span class="label ml-2 text-muted">
                      ISBN {f.data.isbn}
                    </span>
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- Biography, copy-paste ready -->
  <section id="biography" class="surface scroll-mt-24 border-t border-line py-20 lg:py-24">
    <div class="shell grid gap-16 lg:grid-cols-[22rem_1fr] lg:gap-24">
      <header>
        <p class="label text-muted">Biography</p>
        <h2 class="mt-5 text-h2 text-fg">Author biography.</h2>
        <p class="mt-6 text-muted">
          Approved for publication as written.
        </p>
      </header>

      <div class="space-y-10">
        <div>
          <blockquote class="border-l-2 border-line pl-6">
            <p class="text-muted">{author.long}</p>
          </blockquote>
        </div>
        <div>
          <p class="label text-muted">Book description</p>
          <blockquote class="mt-4 border-l-2 border-line pl-6">
            <p class="text-muted">{book.description}</p>
          </blockquote>
        </div>
      </div>
    </div>
  </section>

  <!-- Photography: a press kit that makes journalists ask for the basics is
       not a press kit. The portrait is downloadable at its supplied
       resolution from a stable, meaningfully named URL. -->
  <section id="photography" class="surface scroll-mt-24 border-t border-line py-20 lg:py-24">
    <div class="shell grid gap-16 lg:grid-cols-[22rem_1fr] lg:gap-24">
      <header>
        <p class="label text-muted">Photography</p>
        <h2 class="mt-5 text-h2 text-fg">Press photography.</h2>
        <p class="mt-6 text-muted">
          Downloadable images for print and online coverage.
        </p>
      </header>

      <div>
        <div class="grid gap-10 sm:grid-cols-2">
          <figure>
            <Image
              src={cover}
              alt={`The cover of ${book.title}: a human eye against pale regenerative imagery, beneath the subtitle "${book.subtitle}"`}
              widths={[288, 448, 576]}
              sizes="(max-width: 639px) 90vw, 18rem"
              loading="lazy"
              decoding="async"
              class="press-asset w-full max-w-[18rem]"
            />
            <figcaption class="label mt-4 text-muted">
              Cover art &middot; PNG &middot; 1600 &times; 2158
            </figcaption>
            <a
              href="/cover-chaos-to-creation.png"
              download="chaos-to-creation-cover.png"
              class="btn btn-ghost mt-4"
            >
              Download cover art
            </a>
          </figure>

          <figure>
            <Image
              src={portrait}
              alt={`${author.fullName}, photographed in front of his framed qualifications`}
              widths={[288, 448, 576]}
              sizes="(max-width: 639px) 90vw, 18rem"
              loading="lazy"
              decoding="async"
              class="press-asset w-full max-w-[18rem]"
              style="view-transition-name: author-portrait"
            />
            <figcaption class="label mt-4 text-muted">
              The author &middot; JPG &middot; 750 &times; 1000
            </figcaption>
            <a
              href="/portrait-gordon-slater-hero.jpg"
              download="gordon-slater-portrait.jpg"
              class="btn btn-ghost mt-4"
            >
              Download portrait
            </a>
          </figure>

          <figure>
            <Image
              src={launch}
              alt={`The hardcover edition of ${book.title} standing on a table, beneath the words "Now available on Amazon"`}
              widths={[288, 448, 576]}
              sizes="(max-width: 639px) 90vw, 18rem"
              loading="lazy"
              decoding="async"
              class="press-asset w-full max-w-[18rem]"
            />
            <figcaption class="label mt-4 text-muted">
              Launch shot &middot; JPG &middot; 1600 &times; 2000
            </figcaption>
            <a
              href="/launch-chaos-to-creation.jpg"
              download="chaos-to-creation-launch.jpg"
              class="btn btn-ghost mt-4"
            >
              Download launch shot
            </a>
          </figure>
        </div>

        <p class="mt-8 text-sm text-muted">
          Supplied for editorial use alongside coverage of the book or its
          author. Print-resolution photography and cover art are available <a
            href="/contact/"
            class="underline decoration-line underline-offset-4 transition-colors hover:text-fg"
            >on request</a
          >.
        </p>
      </div>
    </div>
  </section>

  <style>
    .press-asset {
      border: 1px solid var(--color-line);
      box-shadow: var(--elevation);
    }
  </style>

  <!-- Coverage -->
  <section id="coverage" class="surface scroll-mt-24 border-t border-line py-20 lg:py-24">
    <div class="shell grid gap-16 lg:grid-cols-[22rem_1fr] lg:gap-24">
      <header>
        <p class="label text-muted">Coverage</p>
        <h2 class="mt-5 text-h2 text-fg">In the press.</h2>
      </header>

      <div>
        {
          press.length > 0 ? (
            <ul class="divide-y divide-line">
              {press.map((p) => (
                <li class="py-6 first:pt-0">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                    <h3 class="text-h3 !text-[1.125rem] font-semibold text-fg">
                      {p.data.outlet}
                    </h3>
                    <p class="label text-muted">
                      {dateFmt.format(p.data.date)}
                    </p>
                  </div>
                  {p.data.quote && (
                    <p class="mt-3 max-w-measure text-muted">
                      {p.data.quote}
                    </p>
                  )}
                  {p.data.url && (
                    <a
                      href={p.data.url}
                      target="_blank" rel="noopener"
                      class="label mt-1 inline-flex min-h-11 items-center !text-[0.8125rem] text-fg underline decoration-line underline-offset-4 transition-colors hover:text-muted"
                    >
                      Read the piece
                    </a>
                  )}
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-muted">Coverage will be listed here as it runs.</p>
          )
        }

        {
          endorsements.length > 0 && (
            <div class="mt-16">
              <p class="label text-muted">Endorsements</p>
              <ul class="mt-6 space-y-8">
                {endorsements.map((e) => (
                  <li>
                    <blockquote class="border-l-2 border-line pl-6">
                      <p class="text-lead text-muted">{e.data.quote}</p>
                      <footer class="label mt-3 text-muted">
                        {e.data.name} &mdash; {e.data.title}
                      </footer>
                    </blockquote>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- Enquiries -->
  <section class="surface py-20 lg:py-24">
    <div class="shell flex flex-wrap items-center justify-between gap-8">
      <div>
        <h2 class="text-h3 text-fg">Need assets or an interview?</h2>
        <p class="mt-3 max-w-[46ch] text-muted">
          High-resolution cover art, author photography and review copies are
          available on request.
        </p>
      </div>
      <a href="/contact/" class="btn btn-primary">Contact the team</a>
    </div>
  </section>
</Base>
