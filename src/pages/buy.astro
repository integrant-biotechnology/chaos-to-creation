---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BestsellerMark from '../components/BestsellerMark.astro';
import EditionCards from '../components/EditionCards.astro';
import launch from '../assets/launch.jpg';
import book from '../data/book.json';
import {
  bookNode,
  personNode,
  breadcrumbNode,
  bestsellerAward,
  faqNode,
} from '../lib/schema';

/** The three purchase-anxiety questions, reused from the FAQ collection. */
const purchaseFaqSlugs = [
  'which-edition-should-i-buy',
  'do-you-ship-internationally',
  'can-i-order-copies-in-bulk',
];
const purchaseFaq = (await getCollection('faq'))
  .filter((f) => purchaseFaqSlugs.includes(f.id))
  .sort((a, b) => a.data.order - b.data.order);

const schema = [
  personNode(),
  await bookNode(),
  await faqNode(purchaseFaqSlugs),
  breadcrumbNode([
    { name: 'Home', path: '/' },
    { name: 'Buy', path: '/buy/' },
  ]),
];

/** Newest press item — the checkable source behind the best-seller claim. */
const press = (await getCollection('press')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
)[0];
const pressDate = press
  ? new Intl.DateTimeFormat('en-AU', { month: 'long', year: 'numeric' }).format(
      press.data.date,
    )
  : null;

const reassurance = [
  'Secure checkout on Amazon',
  'Fulfilled and shipped by Amazon AU',
  'Kindle edition delivers instantly',
];
---

<Base
  title={`Buy ${book.title} — hardcover, paperback and Kindle`}
  description={`${bestsellerAward}. Order ${book.title}: ${book.subtitle} by Prof. Gordon Slater in hardcover, paperback or Kindle through Amazon Australia.`}
  schema={schema}
>
  <!-- One continuous flow: intro, cards, handoff reassurance. A utility page
       gets one headline, not a manifesto and then a second headline. -->
  <section class="surface">
    <div class="shell pb-16 pt-10 lg:pb-20 lg:pt-12">
      <div
        class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,15rem)] lg:items-center lg:gap-16"
      >
        <div>
          <p class="eyebrow">Editions</p>
          <h1 class="hang mt-4 text-h2">Order the book</h1>
          <p class="mt-4 max-w-[46ch] text-lead text-muted">
            {book.title} has been an Amazon Best Seller. Three editions, all
            fulfilled by Amazon Australia.
          </p>

          <div class="mt-6">
            <BestsellerMark variant="seal" withAuthor />
            {
              press && (
                <p class="eyebrow mt-3 !text-[0.8125rem] text-muted">
                  Featured in{' '}
                  <a
                    href={press.data.url}
                    target="_blank"
                    rel="noopener"
                    class="text-fg underline decoration-line underline-offset-4 transition-colors hover:text-accent"
                  >
                    {press.data.outlet}
                    <span class="sr-only"> (opens in a new tab)</span>
                  </a>{' '}
                  &middot; {pressDate}
                </p>
              )
            }
          </div>
        </div>

        <figure class="mx-auto w-full max-w-[15rem] lg:mx-0 lg:max-w-none">
          <Image
            src={launch}
            alt={`The hardcover edition of ${book.title} standing on a table, beneath the words "Now available on Amazon"`}
            widths={[272, 400, 560]}
            sizes="15rem"
            loading="eager"
            fetchpriority="high"
            class="launch-plate w-full"
          />
          <figcaption class="label mt-4 flex items-center gap-3 text-muted">
            <span class="whitespace-nowrap text-metal">Plate IV</span>
            <span aria-hidden="true" class="h-px flex-1 bg-line"></span>
            <span class="whitespace-nowrap">The hardcover, at launch</span>
          </figcaption>
        </figure>
      </div>

      <div class="mt-10 lg:mt-12">
        <EditionCards />
      </div>

      <!-- What happens after the click, named at the moment of maximum
           hesitation — a quiet row inside the same section, not another band. -->
      <ul
        class="mt-10 flex flex-col gap-x-12 gap-y-3 border-t border-line pt-8 sm:flex-row sm:flex-wrap sm:items-center"
      >
        {
          reassurance.map((item) => (
            <li class="eyebrow flex items-center gap-3 text-muted">
              <span
                aria-hidden="true"
                class="inline-block size-1.5 rotate-45 bg-metal"
              />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Answers and the institutional path, one section. The header column
       carries the bulk-order callout — filling what was dead space below
       the h2, and retiring what was previously a fifth band. -->
  <section class="surface-sunken border-t border-line pb-16 pt-24 lg:pb-20 lg:pt-28">
    <div class="shell grid gap-16 lg:grid-cols-[22rem_1fr] lg:gap-24">
      <header>
        <p class="eyebrow">Before you order</p>
        <h2 class="hang mt-5 text-h2 text-fg">Three quick answers.</h2>

        <div class="mt-12 border-t border-line pt-8">
          <h3 class="text-h3 !text-[1.25rem] text-fg">
            Ordering for an institution?
          </h3>
          <p class="mt-3 text-sm text-muted">
            Universities, hospitals, libraries and conferences order in bulk
            directly &mdash; with invoicing, not a cart.
          </p>
          <a href="/contact/" class="btn btn-ghost mt-6">Start a bulk enquiry</a>
        </div>
      </header>

      <dl class="divide-y divide-line">
        {
          purchaseFaq.map((f) => (
            <div class="py-6 first:pt-0 last:pb-0">
              <dt class="text-h3 !text-[1.125rem] font-semibold text-fg">
                {f.data.question}?
              </dt>
              <dd class="mt-2 max-w-measure text-muted">{f.data.answer}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</Base>

<style>
  .launch-plate {
    border: 1px solid var(--color-line);
    box-shadow: var(--elevation);
  }
</style>
