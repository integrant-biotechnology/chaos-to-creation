---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Hallmarks from '../components/Hallmarks.astro';
import Thesis from '../components/Thesis.astro';
import AuthorCard from '../components/AuthorCard.astro';
import BuySection from '../components/BuySection.astro';
import book from '../data/book.json';
import {
  bookNode,
  personNode,
  websiteNode,
  bestsellerAward,
} from '../lib/schema';

const schema = [websiteNode(), personNode(), await bookNode()];

// Lead the search snippet with the accolade — it is the strongest
// click-through signal the page has.
const description = book.bestseller.claimed
  ? `${bestsellerAward}. ${book.summary}`
  : book.summary;
---

<Base
  title={`${book.title}: ${book.subtitle} — Prof. Gordon Slater`}
  description={description}
  schema={schema}
>
  <Hero />
  <Hallmarks />
  <Thesis />
  <AuthorCard />
  <BuySection />
</Base>
