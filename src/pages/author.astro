---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import author from '../data/author.json';
import book from '../data/book.json';
import { personNode, breadcrumbNode } from '../lib/schema';

const schema = [
  personNode(),
  breadcrumbNode([
    { name: 'Home', path: '/' },
    { name: 'Author', path: '/author/' },
  ]),
];
---

<Base
  title={`${author.fullName} — ${book.title}`}
  description={author.short}
  schema={schema}
>
  <PageHeader
    figure="Figure 5 · The author"
    title={author.fullName}
    lede={author.short}
  />

  <section class="register-light py-24 lg:py-32">
    <div class="shell grid gap-16 lg:grid-cols-[1fr_20rem] lg:gap-24">
      <div>
        <p class="max-w-measure text-lead text-ink/85">{author.long}</p>

        <hr class="rule my-14 text-ink" />

        <h2 class="text-h3 text-ink">Why he wrote this book</h2>
        <p class="mt-5 max-w-measure text-ink/75">
          Three decades of operating gives you a particular view of the body:
          you see, directly and repeatedly, what tissue does when it is damaged
          and what it does when it repairs. That vantage point is unusual among
          people writing about longevity, and it is the one this book is
          written from.
        </p>

        <h2 class="mt-14 text-h3 text-ink">Speaking and media</h2>
        <p class="mt-5 max-w-measure text-ink/75">
          Professor Slater considers selected speaking engagements, interviews
          and commentary on regenerative medicine, longevity science and
          surgical innovation.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact/" class="btn btn-primary">Make an enquiry</a>
          <a href="/press/" class="btn btn-ghost !text-ink">Press kit</a>
        </div>
      </div>

      <aside class="lg:sticky lg:top-12 lg:self-start">
        <p class="label text-graphite">Credentials</p>
        <dl class="mt-5 space-y-4">
          {
            author.credentials.map((c) => (
              <div class="border-t border-ink/12 pt-4">
                <dt class="label text-ink">{c.label}</dt>
                <dd class="mt-1.5 text-sm text-graphite">{c.detail}</dd>
              </div>
            ))
          }
        </dl>

        <p class="label mt-12 text-graphite">Elsewhere</p>
        <ul class="mt-5 space-y-3">
          {
            author.social.map((s) => (
              <li class="border-t border-ink/12 pt-3">
                <a
                  href={s.url}
                  rel="noopener me"
                  class="group flex items-center justify-between gap-3 text-sm text-ink transition-colors hover:text-graphite"
                >
                  <span>{s.name}</span>
                  <span aria-hidden="true" class="text-graphite">&rarr;</span>
                </a>
              </li>
            ))
          }
          <li class="border-t border-ink/12 pt-3">
            <a
              href={author.practiceUrl}
              rel="noopener"
              class="flex items-center justify-between gap-3 text-sm text-ink transition-colors hover:text-graphite"
            >
              <span>Surgical practice</span>
              <span aria-hidden="true" class="text-graphite">&rarr;</span>
            </a>
          </li>
        </ul>
      </aside>
    </div>
  </section>
</Base>
